{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-perception.dev/schemas/v2/information-need.schema.json",
  "title": "Interaction Uncertainty v0.2 InformationNeed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "need_id",
    "task_key",
    "proposition_id",
    "anchor_token",
    "deficit_kind",
    "probability",
    "decision_relevance",
    "max_task_risk_reduction",
    "sufficiency_shortfall",
    "priority",
    "source_deficit_ids"
  ],
  "properties": {
    "need_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_key": {"$ref": "#/$defs/taskKey"},
    "proposition_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "anchor_token": {"type": "string", "minLength": 1, "maxLength": 256},
    "deficit_kind": {
      "enum": [
        "IDENTITY_AMBIGUITY",
        "PRESENCE_UNCERTAINTY",
        "OCCLUDED_REGION",
        "UNOBSERVED_SURFACE",
        "LOW_RESOLUTION",
        "SEARCH_COVERAGE_GAP",
        "ACCESS_BLOCKED"
      ]
    },
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "decision_relevance": {"type": "number", "minimum": 0, "maximum": 1},
    "max_task_risk_reduction": {"type": "number", "minimum": 0},
    "sufficiency_shortfall": {"type": "number", "minimum": 0, "maximum": 1},
    "priority": {"type": "number", "minimum": 0},
    "source_deficit_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  },
  "$defs": {
    "taskKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "prompt_digest", "ontology_id", "ontology_version"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "prompt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ontology_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "ontology_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
