{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-perception.dev/schemas/v2/policy-response.schema.json",
  "title": "Interaction Uncertainty v0.2 Policy Service Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "candidate_id",
    "primitive_kind",
    "action_chunk"
  ],
  "properties": {
    "schema_version": {"const": "interaction-uncertainty.policy-response.v2"},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "primitive_kind": {
      "enum": [
        "DIRECT_ACT",
        "OPEN_CONTAINER",
        "PULL_DRAWER",
        "UNCOVER",
        "CLEAR_OCCLUDER",
        "PUSH_ASIDE",
        "BRING_CLOSER",
        "ROTATE_TO_LABEL",
        "PICK_AND_INSPECT",
        "STOP_NOT_FOUND"
      ]
    },
    "action_chunk": {
      "$ref": "https://interactive-perception.dev/schemas/v2/action-chunk.schema.json"
    }
  }
}
