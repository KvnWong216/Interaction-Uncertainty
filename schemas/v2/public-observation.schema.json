{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-perception.dev/schemas/v2/public-observation.schema.json",
  "title": "Interaction Uncertainty v0.2 PolicyObservation",
  "$ref": "#/$defs/publicObservation",
  "$defs": {
    "visualAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "frame_id",
        "source",
        "region_xyxy_normalized",
        "affordances",
        "attributes"
      ],
      "properties": {
        "token": {"type": "string", "minLength": 1, "maxLength": 256},
        "frame_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {
          "enum": [
            "policy_vla",
            "deployable_detector",
            "public_user_reference",
            "scripted_public_demo"
          ]
        },
        "region_xyxy_normalized": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "number", "minimum": 0, "maximum": 1}
            }
          ]
        },
        "affordances": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "publicObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "image_refs",
        "proprioception",
        "anchors",
        "action_history"
      ],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "image_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 33554432}
        },
        "proprioception": {
          "type": "array",
          "maxItems": 4096,
          "items": {"type": "number"}
        },
        "anchors": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/visualAnchor"}
        },
        "action_history": {
          "type": "array",
          "maxItems": 4096,
          "items": {"type": "string", "maxLength": 4096}
        }
      }
    }
  }
}
