{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-perception.dev/schemas/v2/action-chunk.schema.json",
  "title": "Interaction Uncertainty v0.2 ActionChunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actions",
    "action_space",
    "normalization_stats_id",
    "backend_id",
    "backend_sha256",
    "rng_seed"
  ],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4096,
        "items": {"type": "number"}
      }
    },
    "action_space": {"type": "string", "minLength": 1, "maxLength": 256},
    "normalization_stats_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "backend_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "backend_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rng_seed": {"type": "integer", "minimum": 0}
  }
}
