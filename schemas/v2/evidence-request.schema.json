{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-perception.dev/schemas/v2/evidence-request.schema.json",
  "title": "Interaction Uncertainty v0.2 Evidence Service Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "context", "observation_digest"],
  "properties": {
    "schema_version": {"const": "interaction-uncertainty.evidence-request.v2"},
    "task": {
      "$ref": "https://interactive-perception.dev/schemas/v2/task-spec.schema.json"
    },
    "context": {
      "$ref": "https://interactive-perception.dev/schemas/v2/policy-context.schema.json"
    },
    "observation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
